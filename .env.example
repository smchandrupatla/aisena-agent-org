# Copy to .env and set a valid GitHub Copilot token locally.
COPILOT_GITHUB_TOKEN=

# Enterprise log export (required by the enterprise-observability profile).
DEPLOYMENT_ENVIRONMENT=local
SPLUNK_PASSWORD=
SPLUNK_API_URL=https://splunk:8089
SPLUNK_USERNAME=admin
SPLUNK_HEC_ENDPOINT=https://splunk:8088/services/collector
SPLUNK_HEC_TOKEN=
SPLUNK_HEC_INDEX=main
SPLUNK_HEC_TLS_INSECURE=true
DYNATRACE_OTLP_ENDPOINT=https://example.live.dynatrace.com/api/v2/otlp
DYNATRACE_API_TOKEN=
# Tenant query base URL; token also needs permission to read logs.
DYNATRACE_API_URL=https://example.live.dynatrace.com
