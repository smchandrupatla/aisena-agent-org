# AISENA HSFS Backend Environment Variables

# --- Kafka ---
KAFKA_BROKER=kafka:9093

# --- PostgreSQL ---
PG_HOST=postgres
PG_PORT=5432
PG_USER=aisena
PG_PASSWORD=aisena_pw
PG_DATABASE_CASE_MANAGEMENT=case_management
PG_DATABASE_AUDIT=audit_log

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Temporal ---
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_TASK_QUEUE=hsfs-screening

# --- Service URLs ---
SCREENING_ENGINE_URL=http://screening-engine:3002
CASE_MANAGEMENT_URL=http://case-management:3003
AGENT_RUNTIME_URL=http://agent-runtime:3001
AUDIT_NOTIFICATION_URL=http://audit-notification:3005

# --- Auth ---
JWT_SECRET=mock-secret-change-in-production

# --- Alerting ---
SLACK_WEBHOOK_URL=

# --- Optional host-port overrides (isolated defaults) ---
HSFS_API_GATEWAY_PORT=13000
HSFS_AGENT_RUNTIME_PORT=13001
HSFS_SCREENING_ENGINE_PORT=13002
HSFS_CASE_MANAGEMENT_PORT=13003
HSFS_ENRICHMENT_SERVICE_PORT=13004
HSFS_AUDIT_NOTIFICATION_PORT=13005
HSFS_WORKFLOW_SERVER_PORT=14000
HSFS_TEMPORAL_UI_PORT=18233
HSFS_GRAFANA_PORT=13006
HSFS_PROMETHEUS_PORT=19090
