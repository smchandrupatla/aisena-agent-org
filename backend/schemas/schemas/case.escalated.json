{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aisena.org/schemas/case.escalated.json",
  "title": "CaseEscalated",
  "description": "Published when a case is escalated to the compliance team.",
  "type": "object",
  "required": ["eventId", "caseId", "transactionId", "occurredAt", "reason", "escalatedTo", "notes"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "caseId": { "type": "string" },
    "transactionId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "reason": { "type": "string" },
    "escalatedTo": { "type": "string" },
    "notes": { "type": "string" }
  }
}
