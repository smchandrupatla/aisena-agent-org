{
  "name": "temporal-hsfs",
  "version": "1.0.0",
  "description": "Temporal workflow orchestration for the AISENA HSFS screening → escalation pipeline",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "start:workflow": "node dist/workflow-starter.js",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "@temporalio/client": "^1.12.6",
    "@temporalio/worker": "^1.12.6",
    "@temporalio/workflow": "^1.12.6",
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "winston": "^3.14.2",
    "axios": "^1.7.4"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.12.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.13",
    "ts-jest": "^29.2.5",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0"
  }
}
