FROM python:3.12-slim
WORKDIR /workspace
RUN pip install --no-cache-dir requests psycopg2-binary scikit-learn joblib
COPY agents/manager/agent_manager.py /workspace/agents/manager/agent_manager.py
COPY agents/manager/requirements.txt /workspace/agents/manager/requirements.txt
COPY . /workspace
CMD ["python3", "/workspace/agents/manager/agent_manager.py"]
